@model MVCMovie.Models.ImportMovieViewModel

@{
    ViewData["Title"] = "Import Movie";
}

<div class="container py-5">

    <div class="card shadow-lg border-0">

        <div class="card-header bg-success text-white">
            <h3 class="mb-0">🎬 Import Movie</h3>
        </div>

        <div class="card-body">

            <div class="mb-4">

                <label class="form-label fw-bold">
                    Search Movie
                </label>

                <input id="searchMovie"
                       class="form-control form-control-lg"
                       placeholder="Start typing a movie title..." />

                <div id="movieSuggestions"
                     class="list-group mt-2 shadow"
                     style="max-height:350px; overflow-y:auto;">
                </div>

            </div>

            <hr />

            <div class="row">

                <div class="col-md-4 text-center">

                    <img id="posterImage"
                         src="https://placehold.co/300x450?text=No+Poster"
                         class="img-fluid rounded shadow" />

                </div>

                <div class="col-md-8">

                    <form asp-action="Import" method="post">

                        <div class="mb-3">
                            <label class="form-label">Title</label>
                            <input asp-for="Title"
                                   id="Title"
                                   class="form-control" />
                            <input asp-for="PosterUrl" id="PosterUrl" type="hidden" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Genre</label>
                            <input asp-for="Genre"
                                   id="Genre"
                                   class="form-control" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Release Date</label>
                            <input asp-for="ReleaseDate"
                                   id="ReleaseDate"
                                   type="date"
                                   class="form-control" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label">IMDb Rating</label>
                            <input asp-for="Rating"
                                   id="Rating"
                                   class="form-control" />
                        </div>

                        <div class="mb-4">
                            <label class="form-label">Price</label>
                            <input asp-for="Price"
                                   id="Price"
                                   class="form-control" />
                        </div>

                        <button class="btn btn-success btn-lg">
                            Save Movie
                        </button>

                    </form>

                </div>

            </div>

        </div>

    </div>

</div>

@section Scripts{

<script>

const searchBox = document.getElementById("searchMovie");
const suggestions = document.getElementById("movieSuggestions");

searchBox.addEventListener("input", async function () {

    const query = this.value.trim();

    if(query.length < 2)
    {
        suggestions.innerHTML = "";
        return;
    }

    const response = await fetch(`/Movies/SearchMovie?query=${encodeURIComponent(query)}`);

    const movies = await response.json();

    suggestions.innerHTML = "";

    movies.forEach(movie => {

    const item = document.createElement("a");

    item.href = "#";

    item.className = "list-group-item list-group-item-action";

    item.innerHTML = `
        <div class="d-flex align-items-center">

            <img src="${movie.poster ?? 'https://placehold.co/60x90'}"
                 width="50"
                 class="rounded me-3">

            <div>
                <strong>${movie.title}</strong><br>
                <small>${movie.year}</small>
            </div>

        </div>
    `;

    item.addEventListener("click", async function (e) {

        e.preventDefault();

        // Clear suggestions
        suggestions.innerHTML = "";

        // Show selected title in search box
        searchBox.value = movie.title;

        // Get complete movie details
        const response = await fetch(`/Movies/GetMovieDetails?id=${movie.id}`);

        const details = await response.json();

        // Fill form
        document.getElementById("Title").value = details.title;
        document.getElementById("Genre").value = details.genre;
        document.getElementById("Rating").value = details.rating;

        if(details.releaseDate){
            document.getElementById("ReleaseDate").value =
                details.releaseDate.substring(0,10);
        }

        document.getElementById("posterImage").src =
            details.poster;
        document.getElementById("PosterUrl").value = details.poster;
    });

    suggestions.appendChild(item);

});

});

</script>

}