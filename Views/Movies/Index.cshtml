@model MVCMovie.Models.MovieGenreViewModel

@{
    ViewData["Title"] = "Movies";
}

<div class="container py-5">

    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-3">

        <div>
            <h1 class="fw-bold text-primary">🎬 Movie Watchlist</h1>
            <p class="text-muted mb-0">
                Browse, search, and manage your movies.
            </p>
        </div>

        <div class="d-flex gap-2">
            <a asp-action="Create" class="btn btn-primary">
                ➕ Add Movie
            </a>

            <a asp-action="Import" class="btn btn-success">
                📥 Import Movie
            </a>
        </div>

    </div>

    <!-- Filter Card -->
    <div class="card shadow-sm border-0 mb-4">

        <div class="card-body">

            <form asp-controller="Movies"
                  asp-action="Index"
                  method="get">

                <div class="row g-3 align-items-end">

                    <div class="col-md-4">

                        <label class="form-label fw-semibold">
                            Genre
                        </label>

                        <select asp-for="MovieGenre"
                                asp-items="Model.Genres"
                                class="form-select">

                            <option value="">All Genres</option>

                        </select>

                    </div>

                    <div class="col-md-5">

                        <label class="form-label fw-semibold">
                            Movie Title
                        </label>

                        <input asp-for="SearchString"
                               class="form-control"
                               placeholder="Search by title..." />

                    </div>

                    <div class="col-md-3 d-grid">

                        <button type="submit"
                                class="btn btn-success">

                            <i class="bi bi-search"></i>
                            Search

                        </button>

                    </div>

                </div>

            </form>

        </div>

    </div>

    <!-- Total Movies -->
    <div class="mb-3">

        <span class="badge bg-secondary fs-6">
            🎬 Total Movies: @(Model.Movies?.Count() ?? 0)
        </span>

    </div>

    <!-- Movies Table -->
    <div class="card shadow border-0">

        <div class="card-header bg-dark text-white">

            <h5 class="mb-0">
                Movie List
            </h5>

        </div>

        <div class="table-responsive">

            <table class="table table-hover table-striped align-middle mb-0">

                <thead class="table-light">

                    <tr>

                        <th class="text-center">Poster</th>
                        <th>Title</th>
                        <th>Genre</th>
                        <th>Price</th>
                        <th>Rating</th>
                        <th class="text-center">Actions</th>

                    </tr>

                </thead>

                <tbody>

                    @if (Model.Movies != null && Model.Movies.Any())
                    {
                        @foreach (var item in Model.Movies)
                        {
                            <tr>

                                <td class="text-center">

                                    <img src="@(!string.IsNullOrWhiteSpace(item.PosterUrl)
                                    ? item.PosterUrl
                                    : Url.Content("~/images/no-poster.png"))"
                                    class="img-thumbnail shadow-sm"
                                    style="width:70px;height:100px;object-fit:cover;"
                                    alt="@item.Title Poster"
                                    onerror="this.onerror=null;this.src='@Url.Content("~/images/no-poster.png")';" />

                                </td>

                                <td>

                                    <div class="fw-bold">
                                        @item.Title
                                    </div>

                                    <small class="text-muted">
                                        @item.ReleaseDate.ToString("dd MMM yyyy")
                                    </small>

                                </td>

                                <td>

                                    <span class="badge bg-info text-dark">
                                        @item.Genre
                                    </span>

                                </td>

                                <td>

                                    @item.Price.ToString("C")

                                </td>

                                <td>

                                    <span class="badge rounded-pill bg-primary px-3 py-2">
                                        ★ @item.Rating / 10
                                    </span>

                                </td>

                                <td class="text-center">

                                    <div class="btn-group" role="group">

                                        <a asp-action="Edit"
                                        asp-route-id="@item.Id"
                                        class="btn btn-warning btn-sm"
                                        title="Edit">

                                        <i class="bi bi-pencil-fill"></i>

                                        </a>

        <a asp-action="Details"
           asp-route-id="@item.Id"
           class="btn btn-info btn-sm text-white"
           title="Details">

            <i class="bi bi-eye-fill"></i>

        </a>

        <a asp-action="Delete"
           asp-route-id="@item.Id"
           class="btn btn-danger btn-sm"
           title="Delete">

            <i class="bi bi-trash-fill"></i>

        </a>

    </div>

                                </td>

                            </tr>
                        }
                    }
                    else
                    {
                        <tr>

                            <td colspan="6" class="text-center py-5">

                                <h4 class="text-muted">
                                    🎬 No Movies Found
                                </h4>

                                <p class="text-muted">
                                    There are currently no movies matching your search.
                                </p>

                                <a asp-action="Create"
                                   class="btn btn-primary mt-2">

                                    ➕ Add Your First Movie

                                </a>

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>

</div>